<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.MainView" prefWidth="1280" prefHeight="780">

    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
    </fx:define>

    <top>
        <MenuBar fx:id="menuBar">
            <menus>
                <Menu text="Fichier">
                    <items>
                        <MenuItem text="Choisir la référence..." onAction="#onChooseReference"/>
                        <MenuItem text="Ajouter des fichiers..." onAction="#onAddCandidates"/>
                        <MenuItem text="Ajouter un dossier..." onAction="#onAddFolder"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Tout vider" onAction="#onClearAll"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Quitter" onAction="#onQuit"/>
                    </items>
                </Menu>
                <Menu text="Affichage">
                    <items>
                        <RadioMenuItem fx:id="lightThemeItem" text="Thème clair"
                                       toggleGroup="$themeGroup" selected="true"
                                       onAction="#onThemeLight"/>
                        <RadioMenuItem fx:id="darkThemeItem" text="Thème sombre"
                                       toggleGroup="$themeGroup"
                                       onAction="#onThemeDark"/>
                    </items>
                </Menu>
                <Menu text="Aide">
                    <items>
                        <MenuItem text="À propos" onAction="#onAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
        <VBox styleClass="side-panel" spacing="8" prefWidth="320" minWidth="260">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <Label text="Fichier de référence" styleClass="section-title"/>
            <ListView fx:id="referenceList" prefHeight="44" minHeight="44" maxHeight="44"/>
            <Button text="Choisir la référence..." maxWidth="Infinity" onAction="#onChooseReference"/>

            <Separator/>

            <Label text="Fichiers à comparer" styleClass="section-title"/>
            <ListView fx:id="candidatesList" VBox.vgrow="ALWAYS"/>
            <HBox spacing="6">
                <Button text="+ Fichiers" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onAddCandidates"/>
                <Button text="+ Dossier" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onAddFolder"/>
            </HBox>
            <HBox spacing="6">
                <Button text="Retirer" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onRemoveSelected"/>
                <Button text="Vider" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onClearCandidates"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <!-- Cartes de statistiques -->
            <HBox spacing="12">
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="kpiCount" text="0" styleClass="kpi-value"/>
                    <Label text="Fichiers comparés" styleClass="kpi-caption"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="kpiMax" text="-" styleClass="kpi-value"/>
                    <Label text="Score maximum" styleClass="kpi-caption"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="kpiAvg" text="-" styleClass="kpi-value"/>
                    <Label text="Score moyen" styleClass="kpi-caption"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="kpiMin" text="-" styleClass="kpi-value"/>
                    <Label text="Score minimum" styleClass="kpi-caption"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="kpiSkipped" text="0" styleClass="kpi-value"/>
                    <Label text="Fichiers ignorés" styleClass="kpi-caption"/>
                </VBox>
            </HBox>

            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>

                    <!-- 1. Classement -->
                    <Tab text="Classement">
                        <VBox spacing="6">
                            <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colRank" text="#" prefWidth="45"/>
                                    <TableColumn fx:id="colFile" text="Fichier" prefWidth="220"/>
                                    <TableColumn fx:id="colLang" text="Langage" prefWidth="90"/>
                                    <TableColumn fx:id="colTokens" text="Tokens" prefWidth="80"/>
                                    <TableColumn fx:id="colKeywords" text="Mots-clés" prefWidth="90"/>
                                    <TableColumn fx:id="colVars" text="Variables / noms" prefWidth="120"/>
                                    <TableColumn fx:id="colScore" text="Score" prefWidth="200"/>
                                    <TableColumn fx:id="colLevel" text="Similarité" prefWidth="90"/>
                                </columns>
                                <placeholder>
                                    <Label text="Choisissez une référence, ajoutez des candidats puis cliquez sur Comparer."/>
                                </placeholder>
                            </TableView>
                            <Label styleClass="hint-label" wrapText="true"
                                   text="Rouge ≥ 70 % · Orange 40–70 % · Vert &lt; 40 %. Un score de similarité n'est pas, à lui seul, une preuve de plagiat."/>
                        </VBox>
                    </Tab>

                    <!-- 2. Graphiques -->
                    <Tab text="Graphiques">
                        <VBox spacing="6">
                            <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                            <BarChart fx:id="scoreChart" title="Score de similarité par fichier (%)"
                                      VBox.vgrow="ALWAYS" legendVisible="false">
                                <xAxis><CategoryAxis/></xAxis>
                                <yAxis><NumberAxis side="LEFT" autoRanging="false"
                                                   lowerBound="0" upperBound="100" tickUnit="20"/></yAxis>
                            </BarChart>
                        </VBox>
                    </Tab>

                    <!-- 3. Mots-clés et variables -->
                    <Tab text="Mots-clés et variables">
                        <VBox spacing="8">
                            <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                            <Label fx:id="selectionLabel" styleClass="section-title"
                                   text="Sélectionnez un fichier dans le classement."/>
                            <HBox spacing="10" prefHeight="280" minHeight="240">
                                <PieChart fx:id="compositionPie" HBox.hgrow="ALWAYS"
                                          legendSide="BOTTOM" labelsVisible="false"/>
                                <BarChart fx:id="compareChart" title="Répartition des tokens (%)"
                                          HBox.hgrow="ALWAYS" legendSide="BOTTOM">
                                    <xAxis><CategoryAxis/></xAxis>
                                    <yAxis><NumberAxis side="LEFT"/></yAxis>
                                </BarChart>
                            </HBox>
                            <Label text="Mots-clés les plus utilisés" styleClass="section-title"/>
                            <TableView fx:id="keywordTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="kwWord" text="Mot-clé" prefWidth="180"/>
                                    <TableColumn fx:id="kwRef" text="Référence" prefWidth="120"/>
                                    <TableColumn fx:id="kwCand" text="Candidat" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- 4. Aperçu du code -->
                    <Tab fx:id="previewTab" text="Aperçu du code">
                        <VBox spacing="8">
                            <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                            <Label fx:id="previewTitle" text="Aperçu" styleClass="section-title"/>
                            <TextArea fx:id="previewArea" editable="false" VBox.vgrow="ALWAYS"
                                      styleClass="code-area"
                                      promptText="Sélectionnez un fichier à gauche pour voir son contenu..."/>
                        </VBox>
                    </Tab>

                </tabs>
            </TabPane>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
            <Label fx:id="statusLabel" text="Prêt"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Algorithme :"/>
            <ComboBox fx:id="algoCombo" prefWidth="260"/>
            <Button fx:id="compareButton" text="Comparer" styleClass="accent-button"
                    onAction="#onCompare"/>
        </HBox>
    </bottom>
</BorderPane>